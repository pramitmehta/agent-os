# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
APP_LOG_LEVEL=info

# Database (use service names in docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agent_os

# Redis / Event Bus (use service name in docker-compose)
REDIS_URL=redis://redis:6379/0
EVENT_BUS_TYPE=redis

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Custom LLM endpoint
LLM_BASE_URL=
LLM_API_KEY=

# Runtime
RUNTIME_MAX_CONCURRENT_TASKS=100
RUNTIME_TIMEOUT_SECONDS=300

# Feature Flags
ENABLE_CHECKPOINTS=false
ENABLE_TELEMETRY=false